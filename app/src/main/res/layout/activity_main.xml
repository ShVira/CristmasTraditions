<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5ED"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="22dp"
            android:background="#294C3B">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textColor="#E6C68E"
                android:textSize="25sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="UKRAINIAN CHRISTMAS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026"
                android:textColor="#E6C68E"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Hero -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_margin="18dp">

            <ImageView
                android:id="@+id/imgHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Українське Різдво"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ЧАС РІЗДВЯНИХ ДИВ"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Магія українського Різдва"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </FrameLayout>

        <!-- Introduction -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  НАША КУЛЬТУРНА СПАДЩИНА  ✧"
                android:textColor="#AE8550"
                android:textSize="11sp"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Різдво, яке живе в серці"
                android:textColor="#294C3B"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Українське Різдво - це більше, ніж свято. Це тепло родинного кола, аромат куті, мерехтіння свічок, дзвінкі колядки та традиції, які об'єднують покоління."
                android:textColor="#71695D"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>

        <!-- Decorative block -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="25dp"
            android:padding="20dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#EDE6D8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❄  ✧  ❄"
                android:textColor="#AE8550"
                android:textSize="23sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="12 традиційних страв"
                android:textColor="#294C3B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="7dp"
                android:text="Свята вечеря, кутя, узвар та багато інших символів українського Святвечора."
                android:textColor="#71695D"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- Preview section -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Трохи різдвяної атмосфери"
            android:textColor="#294C3B"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_margin="22dp"
            android:scaleType="centerCrop"
            android:contentDescription="Українські різдвяні традиції"/>

        <!-- Button -->

        <Button
            android:id="@+id/btnExplore"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#294C3B"
            android:text="ВІДКРИТИ РІЗДВЯНІ ТРАДИЦІЇ  →"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:text="З ТЕПЛОМ ТА ЛЮБОВ'Ю ДО УКРАЇНСЬКОЇ КУЛЬТУРИ"
            android:textColor="#AE8550"
            android:textSize="10sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

</ScrollView>